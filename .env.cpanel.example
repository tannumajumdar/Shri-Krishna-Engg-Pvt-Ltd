# ---------------------------------------------------------------------------
# cPanel MySQL connection — copy the relevant line into your real `.env`.
#
# cPanel prefixes every database and user with your cPanel account name, e.g.
# if your cPanel user is `shrikri1` and you create a DB called `ske`, the real
# database name becomes `shrikri1_ske` and the user `shrikri1_skeuser`.
# ---------------------------------------------------------------------------

# --- Case A: the Next.js app ALSO runs on the same cPanel (Setup Node.js App)
# Host is localhost because the app and MySQL are on the same server.
DATABASE_URL="mysql://shrikri1_skeuser:YOUR_DB_PASSWORD@localhost:3306/shrikri1_ske"

# --- Case B: the app runs elsewhere (VPS / Vercel / Railway), DB on cPanel
# You must enable cPanel → "Remote MySQL" and add the app server's IP first.
# Host is your cPanel server's hostname or its IP (NOT localhost).
# DATABASE_URL="mysql://shrikri1_skeuser:YOUR_DB_PASSWORD@your-server.hostinger.com:3306/shrikri1_ske"

# If the DB password contains special characters (@ : / # ? & % + space),
# URL-encode them in the string above, e.g.  @ -> %40   # -> %23   / -> %2F

# The rest stays the same as .env.example:
JWT_SECRET="replace-with-64-random-bytes"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@shrikrishnaengineering.in"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="SKE Administrator"
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB="50"
NODE_ENV="production"
