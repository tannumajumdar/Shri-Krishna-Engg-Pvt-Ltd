# ---------------------------------------------------------------------------
# Server-only secrets. NOT prefixed NEXT_PUBLIC_, so Next never ships them to
# the browser bundle. .env is gitignored; commit .env.example instead.
# ---------------------------------------------------------------------------

# Local MySQL (the running NationalPlastoMySQL service, 8.4). Root has no
# password on this machine — set one and update this URL before production.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/ske_db"

# Sign/verify admin JWTs. Rotating this invalidates every live session.
# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-64-random-bytes"

# How long an admin session lasts.
JWT_EXPIRES_IN="7d"

# Seeded on `npm run db:seed`. Change both before any real deployment.
ADMIN_EMAIL="admin@shrikrishnaengineering.in"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="SKE Administrator"

# Local disk upload target under /public. Swap the storage driver in
# lib/storage.ts for S3/Cloudinary later without touching route code.
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB="50"
